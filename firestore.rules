rules_version = '2';

// Write access is an explicit UID allowlist, NOT "any signed-in user". The
// project's apiKey ships in the public client bundle, and with the
// Email/Password provider enabled anyone can self-register straight against the
// Identity Toolkit REST API - so request.auth != null is not a proxy for "is an
// admin". Add a manager by appending their UID to the list below (Firebase
// Console -> Authentication -> Users -> User UID); nothing else needs changing.
// Keep this list identical to the one in storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid in [
               'oZKjcE1p2mQhmdQ3KbZ7QJV7ulm2'
             ];
    }

    // Hero/site content (App.tsx reads this unauthenticated on every page load).
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy Firestore-authored products (admin.html "Додати новий товар").
    // The storefront no longer reads this (App.tsx now sources the catalog
    // from KeyCRM) - only admin.html's create/edit form still touches it - so
    // read is admin-only too, unlike the collections below.
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // Point discounts keyed by KeyCRM product id (admin.html "Точкова знижка").
    // services/promotions.ts reads active promotions unauthenticated on the
    // storefront, so read must stay public; only admin.html writes.
    match /promotions/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-uploaded extra photos/videos overlaid on the KeyCRM catalog, keyed
    // by KeyCRM product id (admin.html product modal). Read publicly by the
    // storefront (App.tsx) to merge into the product gallery/video section -
    // it's just media URLs, nothing sensitive.
    match /productMedia/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Manually-entered customer reviews, keyed by KeyCRM product id
    // (admin.html product modal - "Відгуки клієнтів"). Read publicly by the
    // storefront (App.tsx) to render on the product page; only admin.html
    // writes. Same pattern as productMedia above.
    match /productReviews/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-photo model measurements ("Зріст 168 см · розмір S"), keyed by
    // KeyCRM product id; each entry inside is keyed by the photo URL, not by
    // gallery index, since KeyCRM can reorder attachments. Read publicly by
    // the storefront (App.tsx) to render the gallery overlay; only admin.html
    // writes. Same pattern as productReviews above.
    match /productModelInfo/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-product editorial flags keyed by KeyCRM product id - currently the
    // manual NEW badge, later visibility and the size-chart override. One
    // collection for all the small scalars so the storefront doesn't pay for
    // another full read per feature. Read publicly by App.tsx; only admins write.
    match /productSettings/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
